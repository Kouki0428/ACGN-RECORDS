{
  "name": "acgn-records",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "ACGN Records - 轻量级 ACGN 进度追踪与统计桌面应用",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/kill-stale.mjs && vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack:win": "npm run build && electron-builder --win --dir",
    "pack:dir": "npm run build && electron-builder --dir",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.10.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^8.0.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.0",
    "electron-rebuild": "^3.2.9",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.13"
  }
}
